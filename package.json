{
  "name": "@bernhardfritz/flatland",
  "description": "A simple 2D graphics library",
  "keywords": [
    "2d",
    "go",
    "webassembly",
    "webgl2"
  ],
  "version": "0.4.0",
  "homepage": "https://pkg.go.dev/github.com/bernhardfritz/flatland",
  "bugs": "https://github.com/bernhardfritz/flatland/issues",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/flatland.js",
  "exports": {
    ".": {
      "import": "./dist/flatland.js"
    },
    "./vite-plugin": {
      "import": "./dist/vite-plugin-flatland.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build && cp vite-plugin-flatland.js dist/"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernhardfritz/flatland.git"
  }
}
